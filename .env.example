# ─── GudCal Core — Environment Variables ──────────────────
# Copy this file to .env.local and fill in your values.
# Required vars are marked with [REQUIRED], optional with [OPTIONAL].

# ─── APP ───────────────────────────────────────────────────
# [REQUIRED] Public URL of your GudCal instance (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] Runtime public URL (server-only, not inlined at Next build).
# The Google Calendar OAuth nonce cookie is Secure when the URL used for
# that flag is https:. Prefer APP_URL at container start. NEXT_PUBLIC_APP_URL
# is baked into the image, so http://localhost:3000 at build cannot flip
# Secure later.
# APP_URL=https://cal.example.com

# ─── AUTH ──────────────────────────────────────────────────
# [REQUIRED] NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# [OPTIONAL] NextAuth URL (auto-detected in most environments)
# NEXTAUTH_URL=http://localhost:3000

# ─── AUTH PROVIDERS ────────────────────────────────────────
# [REQUIRED] Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── DATABASE ──────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string
# Docker:       postgres://gudcal:gudcal_password@localhost:5432/gudcal
# Neon:         postgres://user:password@host/neondb?sslmode=require
DATABASE_URL=

# ─── EMAIL ─────────────────────────────────────────────────
# [REQUIRED] Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# ─── GOOGLE CALENDAR ──────────────────────────────────────
# [OPTIONAL] Separate OAuth credentials for Google Calendar integration
# Can reuse the same Google OAuth app, but needs calendar scopes enabled
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ─── ENCRYPTION ────────────────────────────────────────────
# [REQUIRED for calendar sync] AES-256 key for stored Google OAuth tokens.
# Must be a persistent 64-character hex value. A missing key is an error
# (the app will not mint a random key; tokens would be unreadable after restart).
# Generate with: openssl rand -hex 32
#
# Upgrade: older builds (and Docker) used to invent a random key when this was
# unset. Those tokens cannot be decrypted with a new key. Set ENCRYPTION_KEY
# once, restart, and reconnect Google Calendar if connect already ran.
ENCRYPTION_KEY=

# ─── ANALYTICS ────────────────────────────────────────────
# [OPTIONAL] Microsoft Clarity project ID for session analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── CRON JOBS ─────────────────────────────────────────────
# [REQUIRED] Secret to authenticate cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=
